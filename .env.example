# Copy to .env and generate strong independent secrets. Never commit real secrets.
DATABASE_URL=postgresql://berjis:CHANGE_ME@127.0.0.1:5432/berjis?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:3000
# Generate each with: openssl rand -hex 32
PII_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
PAYMENT_WEBHOOK_SECRET=GENERATE_64_HEX_CHARACTERS
# Only implemented mode. Live mode fails closed.
PROVIDER_MODE=DEMO
# Optional, non-secret: isolate environments sharing one Redis server.
# Default derives from the PostgreSQL database name. Use the same value for web + worker.
# REDIS_NAMESPACE=berjis-staging
