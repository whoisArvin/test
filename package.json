{
  "name": "berjis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build && npm run build:workers",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/server/worker.ts",
    "test": "npm run test:prepare && vitest run",
    "test:e2e": "playwright test",
    "setup": "bash scripts/setup.sh",
    "test:prepare": "tsx scripts/test-db.ts",
    "build:workers": "esbuild src/server/worker.ts scripts/migrate.ts prisma/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --entry-names=[name]",
    "worker:production": "node --env-file=.env dist/worker.js",
    "format": "prettier --write src docs scripts tests *.ts *.mjs *.json *.yaml README.md"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "bullmq": "^6.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns-jalali": "^4.4.0-0",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.7.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  }
}
